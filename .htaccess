<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On

    # Ensure the request is not already pointing to /public/
    RewriteCond %{REQUEST_URI} !^/public/ [NC]

    # Ensure the request is not a real directory or file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    # Redirect all requests to /public/ while preserving the URL structure
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Ensure index.php is always processed
    RewriteRule ^(/)?$ public/index.php [L]
</IfModule>
